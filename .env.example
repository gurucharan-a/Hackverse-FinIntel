# FININT — server-side only. Never expose these to the frontend.
# Leave blank to use free public providers (Yahoo Finance, Google News RSS, SEC EDGAR).

MARKET_API_KEY=
NEWS_API_KEY=
LLM_API_KEY=
SEC_API_KEY=

# Optional aliases
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# App
FININT_HOST=127.0.0.1
FININT_PORT=8000
DATABASE_PATH=data/finint.db
CHROMA_PATH=data/chroma
HTTP_TIMEOUT_SECONDS=20
